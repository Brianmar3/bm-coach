# Neon/Supabase PostgreSQL connection string. Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Random secret with at least 32 characters. Used on the server to authenticate
# the coach and sign HttpOnly administrative sessions. Never prefix it with NEXT_PUBLIC_.
BM_COACH_ADMIN_TOKEN="replace-with-a-random-secret-of-at-least-32-characters"

# Web Push (VAPID). Generate a real key pair outside the repository.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@example.com"
BLOB_READ_WRITE_TOKEN=""

# Random secret with at least 16 characters. Vercel sends it as a Bearer token
# when invoking protected scheduled tasks. Never expose it with NEXT_PUBLIC_.
CRON_SECRET="replace-with-a-random-secret-of-at-least-16-characters"

# Master membership digest. Off until explicitly enabled in Vercel Production.
# Recipient is fixed in code: briiianm36@gmail.com. Preview/local never send.
MASTER_EMAIL_ENABLED="false"
RESEND_API_KEY=""
# Bare email address on a Resend-verified domain.
MASTER_EMAIL_FROM=""
# Canonical HTTPS origin of BM Training; the email links to /master.
MASTER_APP_URL=""

# Optional OpenAI-compatible provider for Nutrición Inteligente.
# Keep the API key server-side. Without these values the module uses its
# deterministic, safety-checked local guidance engine.
NUTRITION_AI_ENABLED="true"
NUTRITION_AI_BASE_URL=""
NUTRITION_AI_API_KEY=""
NUTRITION_AI_MODEL=""
NUTRITION_AI_TIMEOUT_MS="12000"
NUTRITION_AI_DAILY_MESSAGE_LIMIT="5"
NUTRITION_AI_MAX_CONTEXT_MESSAGES="8"
NUTRITION_AI_MAX_OUTPUT_TOKENS="280"
EXERCISE_MEDIA_ENABLED=false
EXERCISE_MEDIA_PROVIDER=local

# Persistent reminder delivery is not part of this basic release.
PAYMENT_REMINDER_DELIVERY_ENABLED=false

# Optional scoring cutover. Use YYYY-MM-01 and keep it fixed after activation.
# Empty preserves the current point policy.
BM_POINTS_POLICY_START=
