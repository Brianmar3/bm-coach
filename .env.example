# Neon/Supabase PostgreSQL connection string. Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Random secret with at least 32 characters. Used on the server to authenticate
# the coach and sign HttpOnly administrative sessions. Never prefix it with NEXT_PUBLIC_.
BM_COACH_ADMIN_TOKEN="replace-with-a-random-secret-of-at-least-32-characters"

# Web Push (VAPID). Generate a real key pair outside the repository.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@example.com"
BLOB_READ_WRITE_TOKEN=""

# Optional OpenAI-compatible provider for Nutrición Inteligente.
# Keep the API key server-side. Without these values the module uses its
# deterministic, safety-checked local guidance engine.
NUTRITION_AI_BASE_URL=""
NUTRITION_AI_API_KEY=""
NUTRITION_AI_MODEL=""
NUTRITION_AI_DAILY_LIMIT="20"
NUTRITION_AI_TIMEOUT_MS="12000"
