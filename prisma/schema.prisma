generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudentRecord {
  id                       String                          @id
  phoneNormalized          String?                         @unique
  primaryScheduleId        String?
  serviceType              StudentServiceType              @default(CLASSES)
  data                     Json
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  payments                 StudentPayment[]
  physicalEvaluations      PhysicalEvaluation[]
  routineAssignments       TrainingRoutineAssignment[]
  weeklyClasses            WeeklyClassAssignment[]
  attendances              ClassAttendance[]
  primarySchedule          WeeklyClassSchedule?            @relation("StudentPrimarySchedule", fields: [primaryScheduleId], references: [id], onDelete: SetNull)
  portalCredential         StudentPortalCredential?
  workoutSessions          WorkoutSession[]
  followUpComments         FollowUpComment[]
  classResponses           ClassOccurrenceAttendance[]
  classWorkoutLogs         ClassWorkoutLog[]
  pushSubscriptions        StudentPushSubscription[]
  achievementNotifications AchievementNotification[]
  quickLogs                QuickLog[]
  quickLogAchievements     QuickLogAchievement[]
  quickLogFeedbacks        QuickLogFeedback[]
  classExerciseFeedbacks   ClassExerciseLogFeedback[]
  pointTransactions        StudentPointTransaction[]
  trainerNotifications     TrainerNotification[]
  notifications            StudentNotification[]
  nutritionCheckins        NutritionDailyCheckin[]
  nutritionNotes           TrainerNutritionNote[]
  nutritionProfile         NutritionProfile?
  nutritionRecipes         NutritionRecipe[]
  nutritionMealPlans       NutritionMealPlan[]
  nutritionShoppingLists   NutritionShoppingList[]
  nutritionPantrySessions  NutritionPantrySession[]
  nutritionFavorites       NutritionFavorite[]
  nutritionConversations   NutritionConversation[]
  nutritionAIInteractions  NutritionAIInteraction[]
  nutritionEducation       NutritionEducationProgress[]
  nutritionAnalytics       NutritionAnalyticsEvent[]
  nutritionAIUsage         NutritionAIUsage[]
  nutritionAIRequests      NutritionAIRequest[]
  nutritionQuizAttempts    NutritionEducationQuizAttempt[]
  membershipHistory        StudentMembershipHistory[]
  monthlyObligations       MonthlyStudentObligation[]
  statusEvents             StudentStatusEvent[]

  @@index([primaryScheduleId])
  @@map("students")
}

enum MembershipHistoryStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StudentStatusEventType {
  ENROLLMENT
  DEACTIVATION
  SUSPENSION
  REACTIVATION
}

enum MonthlyObligationStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum MonthlySummaryStatus {
  DRAFT
  CLOSED
}

model StudentMembershipHistory {
  id            String                  @id @default(cuid())
  studentId     String
  startDate     DateTime                @db.Date
  endDate       DateTime?               @db.Date
  planName      String
  frequencyDays Int?
  serviceType   StudentServiceType
  monthlyAmount Decimal?                @db.Decimal(12, 2)
  status        MembershipHistoryStatus @default(ACTIVE)
  endReason     String?
  createdAt     DateTime                @default(now())
  student       StudentRecord           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, startDate, endDate])
  @@index([startDate, endDate])
  @@map("student_membership_history")
}

model MonthlyStudentObligation {
  id                  String                  @id @default(cuid())
  studentId           String
  period              DateTime                @db.Date
  expectedAmount      Decimal                 @db.Decimal(12, 2)
  paidAmount          Decimal                 @default(0) @db.Decimal(12, 2)
  balance             Decimal                 @db.Decimal(12, 2)
  studentNameSnapshot String
  planNameSnapshot    String
  serviceSnapshot     StudentServiceType
  frequencySnapshot   Int?
  dueDate             DateTime                @db.Date
  status              MonthlyObligationStatus @default(PENDING)
  generatedAt         DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  student             StudentRecord           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([studentId, period])
  @@index([period, status])
  @@map("monthly_student_obligations")
}

model StudentStatusEvent {
  id        String                 @id @default(cuid())
  studentId String
  type      StudentStatusEventType
  eventDate DateTime               @db.Date
  reason    String?
  actor     String
  createdAt DateTime               @default(now())
  student   StudentRecord          @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, eventDate])
  @@index([type, eventDate])
  @@map("student_status_events")
}

model MonthlySummary {
  id                   String               @id @default(cuid())
  year                 Int
  month                Int
  status               MonthlySummaryStatus @default(DRAFT)
  historicalPartial    Boolean              @default(false)
  generatedAt          DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  closedAt             DateTime?
  closedBy             String?
  expectedTotal        Decimal?             @db.Decimal(14, 2)
  collectedTotal       Decimal              @default(0) @db.Decimal(14, 2)
  pendingTotal         Decimal?             @db.Decimal(14, 2)
  collectionPercentage Decimal?             @db.Decimal(6, 2)
  activeStudentCount   Int?
  enrollmentCount      Int                  @default(0)
  deactivationCount    Int?
  attendancePercentage Decimal?             @db.Decimal(6, 2)
  warnings             Json                 @default("[]")
  snapshot             Json
  version              Int                  @default(1)

  @@unique([year, month])
  @@index([status, year, month])
  @@map("monthly_summaries")
}

model NutritionDailyCheckin {
  id               String        @id @default(cuid())
  studentId        String
  dateKey          String
  hydration        Boolean       @default(false)
  protein          Boolean       @default(false)
  fruitsVegetables Boolean       @default(false)
  mealOrganization Boolean       @default(false)
  energy           Boolean       @default(false)
  comment          String        @default("")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  student          StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, dateKey])
  @@index([studentId, dateKey(sort: Desc)])
  @@map("nutrition_daily_checkins")
}

model TrainerNutritionNote {
  id        String        @id @default(cuid())
  studentId String
  trainerId String
  text      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  student   StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt(sort: Desc)])
  @@map("trainer_nutrition_notes")
}

model NutritionProfile {
  id                      String        @id @default(cuid())
  studentId               String        @unique
  dietaryType             String        @default("")
  allergies               String[]      @default([])
  intolerances            String[]      @default([])
  restrictions            String[]      @default([])
  preferredFoods          String[]      @default([])
  dislikedFoods           String[]      @default([])
  budgetPreference        String        @default("")
  cookingTimeMinutes      Int?
  cookingLevel            String        @default("")
  equipment               String[]      @default([])
  servings                Int           @default(1)
  usualMealTimes          Json?
  repetitionPreference    String        @default("")
  varietyPreference       String        @default("")
  locale                  String        @default("es-AR")
  consentAt               DateTime?
  personalizationEnabled  Boolean       @default(false)
  notificationPreferences Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  student                 StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([personalizationEnabled, updatedAt])
  @@map("nutrition_profiles")
}

model NutritionRecipe {
  id                 String        @id @default(cuid())
  studentId          String
  title              String
  description        String        @default("")
  servings           Int
  preparationMinutes Int
  difficulty         String
  ingredients        Json
  steps              Json
  equipment          String[]      @default([])
  substitutions      Json?
  tags               String[]      @default([])
  warnings           String[]      @default([])
  rationale          String        @default("")
  source             String
  aiModelVersion     String?
  contextSnapshot    Json?
  isFavorite         Boolean       @default(false)
  rating             Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  student            StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt(sort: Desc)])
  @@index([studentId, isFavorite, updatedAt(sort: Desc)])
  @@map("nutrition_recipes")
}

model NutritionMealPlan {
  id              String                  @id @default(cuid())
  studentId       String
  startDate       DateTime                @db.Date
  endDate         DateTime                @db.Date
  status          String                  @default("ACTIVE")
  configuration   Json
  meals           Json
  contextSnapshot Json?
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  student         StudentRecord           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  shoppingLists   NutritionShoppingList[]

  @@index([studentId, active, startDate(sort: Desc)])
  @@map("nutrition_meal_plans")
}

model NutritionShoppingList {
  id         String             @id @default(cuid())
  studentId  String
  mealPlanId String?
  title      String
  status     String             @default("ACTIVE")
  budgetMode Boolean            @default(false)
  items      Json
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  student    StudentRecord      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mealPlan   NutritionMealPlan? @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)

  @@index([studentId, status, updatedAt(sort: Desc)])
  @@index([mealPlanId])
  @@map("nutrition_shopping_lists")
}

model NutritionPantrySession {
  id          String        @id @default(cuid())
  studentId   String
  ingredients Json
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  student     StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, expiresAt(sort: Desc)])
  @@map("nutrition_pantry_sessions")
}

model NutritionFavorite {
  id          String        @id @default(cuid())
  studentId   String
  contentType String
  contentId   String
  label       String
  createdAt   DateTime      @default(now())
  student     StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, contentType, contentId])
  @@index([studentId, createdAt(sort: Desc)])
  @@map("nutrition_favorites")
}

model NutritionConversation {
  id             String             @id @default(cuid())
  studentId      String
  title          String
  status         String             @default("ACTIVE")
  contextSummary String             @default("")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  student        StudentRecord      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages       NutritionMessage[]

  @@index([studentId, updatedAt(sort: Desc)])
  @@map("nutrition_conversations")
}

model NutritionMessage {
  id             String                @id @default(cuid())
  conversationId String
  role           String
  content        String
  structuredData Json?
  safetyCategory String?
  modelVersion   String?
  createdAt      DateTime              @default(now())
  conversation   NutritionConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("nutrition_messages")
}

model NutritionAIInteraction {
  id              String        @id @default(cuid())
  studentId       String
  feature         String
  intention       String
  contextSnapshot Json?
  inputSummary    String
  outputSummary   String
  provider        String
  modelVersion    String?
  usageMetadata   Json?
  latencyMs       Int?
  success         Boolean
  errorCode       String?
  createdAt       DateTime      @default(now())
  student         StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt(sort: Desc)])
  @@index([feature, success, createdAt(sort: Desc)])
  @@map("nutrition_ai_interactions")
}

model NutritionEducationProgress {
  id          String        @id @default(cuid())
  studentId   String
  contentId   String
  viewedAt    DateTime?
  completedAt DateTime?
  favorite    Boolean       @default(false)
  lastSection String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  student     StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, contentId])
  @@index([studentId, updatedAt(sort: Desc)])
  @@map("nutrition_education_progress")
}

model NutritionEducationQuizAttempt {
  id             String        @id @default(cuid())
  studentId      String
  contentId      String
  questionId     String
  selectedAnswer Int
  correct        Boolean
  answeredAt     DateTime      @default(now())
  student        StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, contentId, answeredAt(sort: Desc)])
  @@map("nutrition_education_quiz_attempts")
}

model NutritionAIUsage {
  id            String        @id @default(cuid())
  studentId     String
  dateKey       String
  feature       String
  usedCount     Int           @default(0)
  reservedCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  student       StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, dateKey, feature])
  @@index([dateKey, feature])
  @@map("nutrition_ai_usage")
}

model NutritionAIRequest {
  id             String        @id @default(cuid())
  studentId      String
  requestKey     String        @unique
  dateKey        String
  feature        String
  status         String        @default("PENDING")
  conversationId String?
  expiresAt      DateTime
  errorCode      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  student        StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, dateKey, feature, status])
  @@index([status, expiresAt])
  @@map("nutrition_ai_requests")
}

model NutritionAnalyticsEvent {
  id        String        @id @default(cuid())
  studentId String
  event     String
  metadata  Json?
  createdAt DateTime      @default(now())
  student   StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt(sort: Desc)])
  @@index([event, createdAt(sort: Desc)])
  @@map("nutrition_analytics_events")
}

enum StudentServiceType {
  CLASSES
  PERSONALIZED
  MIXED
}

enum QuickLogType {
  WORKOUT
  NOTE
  PROGRESS
  PHOTO
}

model QuickLog {
  id                  String                @id @default(cuid())
  studentId           String
  type                QuickLogType
  title               String                @default("")
  content             String                @default("")
  category            String                @default("")
  date                DateTime              @db.Date
  durationMinutes     Int?
  exerciseName        String                @default("")
  exerciseKey         String                @default("")
  idempotencyKey      String?               @unique
  sets                Int?
  repetitions         Int?
  previousSets        Int?
  previousRepetitions Int?
  metricType          String                @default("")
  previousValue       Decimal?              @db.Decimal(10, 2)
  currentValue        Decimal?              @db.Decimal(10, 2)
  unit                String                @default("")
  mood                String                @default("")
  hasPain             Boolean               @default(false)
  painDetails         String                @default("")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  student             StudentRecord         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  photos              QuickLogPhoto[]
  achievements        QuickLogAchievement[]
  feedback            QuickLogFeedback?

  @@index([studentId, date(sort: Desc)])
  @@index([studentId, type, date(sort: Desc)])
  @@index([studentId, exerciseKey, createdAt(sort: Desc)])
  @@map("quick_logs")
}

model QuickLogPhoto {
  id           String   @id @default(cuid())
  quickLogId   String
  blobUrl      String
  blobPathname String
  createdAt    DateTime @default(now())
  quickLog     QuickLog @relation(fields: [quickLogId], references: [id], onDelete: Cascade)

  @@index([quickLogId])
  @@map("quick_log_photos")
}

enum QuickLogAchievementType {
  FIRST_MARK
  MAX_LOAD
  REPETITION_PR
  RECORD_MILESTONE
}

model QuickLogAchievement {
  id             String                  @id @default(cuid())
  studentId      String
  quickLogId     String
  achievementKey String
  type           QuickLogAchievementType
  exerciseName   String
  exerciseKey    String
  sets           Int?
  repetitions    Int?
  unit           String                  @default("")
  currentLoad    Decimal?                @db.Decimal(10, 2)
  previousLoad   Decimal?                @db.Decimal(10, 2)
  difference     Decimal?                @db.Decimal(10, 2)
  recordCount    Int?
  unlockedAt     DateTime
  createdAt      DateTime                @default(now())
  student        StudentRecord           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  quickLog       QuickLog                @relation(fields: [quickLogId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementKey])
  @@index([studentId, unlockedAt(sort: Desc)])
  @@index([quickLogId])
  @@map("quick_log_achievements")
}

model QuickLogFeedback {
  id          String        @id @default(cuid())
  quickLogId  String        @unique
  studentId   String
  trainerName String
  preset      String        @default("")
  text        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  quickLog    QuickLog      @relation(fields: [quickLogId], references: [id], onDelete: Cascade)
  student     StudentRecord @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt(sort: Desc)])
  @@map("quick_log_feedback")
}

enum AchievementNotificationStatus {
  BASELINE
  PENDING
  SENT
  FAILED
}

model StudentPushSubscription {
  id          String        @id @default(cuid())
  studentId   String
  endpoint    String        @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceLabel String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lastUsedAt  DateTime?
  student     StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, active])
  @@map("student_push_subscriptions")
}

model AchievementNotification {
  id             String                        @id @default(cuid())
  studentId      String
  achievementKey String
  unlockedAt     DateTime
  notifiedAt     DateTime?
  celebratedAt   DateTime?
  status         AchievementNotificationStatus @default(PENDING)
  error          String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  student        StudentRecord                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementKey])
  @@index([studentId, status])
  @@index([studentId, celebratedAt, createdAt])
  @@index([status, createdAt])
  @@map("achievement_notifications")
}

enum StudentNotificationType {
  MESSAGE
  FEEDBACK
  ANNOUNCEMENT
  EVENT
  NEWS
  REMINDER
  ACHIEVEMENT
  POINTS
}

model StudentNotification {
  id        String                  @id @default(cuid())
  studentId String
  type      StudentNotificationType
  title     String
  message   String
  url       String                  @default("/portal")
  readAt    DateTime?
  createdAt DateTime                @default(now())
  student   StudentRecord           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, readAt, createdAt(sort: Desc)])
  @@map("student_notifications")
}

enum TrainerNotificationType {
  CLASS_RESPONSE
  POINTS
}

model TrainerPushSubscription {
  id          String    @id @default(cuid())
  ownerKey    String    @default("coach")
  endpoint    String    @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceLabel String?
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerKey, active])
  @@map("trainer_push_subscriptions")
}

model TrainerNotification {
  id              String                  @id @default(cuid())
  ownerKey        String                  @default("coach")
  type            TrainerNotificationType
  eventKey        String                  @unique
  title           String
  message         String
  url             String
  studentId       String?
  occurrenceId    String?
  response        ClassResponseStatus?
  readAt          DateTime?
  pushAttemptedAt DateTime?
  pushDeliveredAt DateTime?
  pushError       String?
  createdAt       DateTime                @default(now())
  student         StudentRecord?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  occurrence      ClassOccurrence?        @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  @@index([ownerKey, readAt, createdAt(sort: Desc)])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([occurrenceId, createdAt(sort: Desc)])
  @@map("trainer_notifications")
}

enum StudentPointEventType {
  ATTENDANCE
  RECORD
  PERSONAL_RECORD
  ACHIEVEMENT
  MILESTONE
}

enum StudentPointSourceType {
  CLASS_OCCURRENCE_ATTENDANCE
  LEGACY_ATTENDANCE
  QUICK_LOG
  CLASS_WORKOUT_LOG
  WORKOUT_SESSION
  ACHIEVEMENT
}

model StudentPointTransaction {
  id            String                 @id @default(cuid())
  studentId     String
  eventKey      String
  eventType     StudentPointEventType
  sourceType    StudentPointSourceType
  sourceId      String?
  points        Int
  description   String
  occurredAt    DateTime
  active        Boolean                @default(true)
  invalidatedAt DateTime?
  notifiedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  student       StudentRecord          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, eventKey])
  @@index([studentId, active, occurredAt(sort: Desc)])
  @@index([active, occurredAt(sort: Desc)])
  @@map("student_point_transactions")
}

model StudentPortalCredential {
  studentId           String                 @id
  username            String                 @unique
  passwordHash        String
  active              Boolean                @default(true)
  mustChangePassword  Boolean                @default(true)
  failedLoginAttempts Int                    @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  student             StudentRecord          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessions            StudentPortalSession[]

  @@map("student_portal_credentials")
}

model StudentPortalSession {
  id         String                  @id @default(cuid())
  studentId  String
  tokenHash  String                  @unique
  expiresAt  DateTime
  createdAt  DateTime                @default(now())
  lastUsedAt DateTime                @default(now())
  credential StudentPortalCredential @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@index([studentId])
  @@index([expiresAt])
  @@map("student_portal_sessions")
}

enum StudentPaymentStatus {
  PAGADO
  PENDIENTE
  VENCIDO
  PROXIMO_A_VENCER
  ANULADO
}

model StudentPayment {
  id                  String               @id @default(cuid())
  studentId           String
  amount              Decimal              @db.Decimal(12, 2)
  concept             String
  billingPeriod       DateTime?            @db.Date
  dueDate             DateTime
  nextDueDateSnapshot DateTime?            @db.Date
  paidDate            DateTime?
  method              String
  status              StudentPaymentStatus @default(PENDIENTE)
  notes               String               @default("")
  requestKey          String?              @unique
  voidedAt            DateTime?
  voidReason          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  student             StudentRecord        @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([studentId, paidDate])
  @@index([studentId, billingPeriod])
  @@index([status, dueDate])
  @@map("student_payments")
}

model PaymentRecord {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model EventRecord {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

enum CoachEventType {
  EVALUACION
  REUNION
  COMPETENCIA
  RECORDATORIO
}

enum CoachEventStatus {
  PENDIENTE
  COMPLETADO
}

model CoachEvent {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  date        DateTime
  time        String
  color       String           @default("#facc15")
  type        CoachEventType
  status      CoachEventStatus @default(PENDIENTE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([date, time])
  @@index([status])
  @@map("coach_events")
}

model RoutineRecord {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("routines")
}

enum TrainingRoutineLevel {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

enum TrainingRoutineStatus {
  BORRADOR
  ACTIVA
  FINALIZADA
  ARCHIVADA
}

enum TrainingRoutineKind {
  ASSIGNED
  TEMPLATE
}

enum TrainingEffortType {
  RPE
  RIR
}

enum TrainingBlockType {
  STRENGTH
  ROUNDS
  INTERVAL
  EMOM
  AMRAP
  FOR_TIME
  FREE
}

enum TrainingExerciseTargetType {
  TIME
  REPS
  DISTANCE
  REST
  FREE
}

model TrainingRoutine {
  id              String                      @id @default(cuid())
  name            String
  objective       String
  level           TrainingRoutineLevel
  status          TrainingRoutineStatus       @default(ACTIVA)
  kind            TrainingRoutineKind         @default(ASSIGNED)
  description     String                      @default("")
  location        String                      @default("")
  equipment       String[]                    @default([])
  tags            String[]                    @default([])
  startDate       DateTime?                   @db.Date
  durationWeeks   Int?
  priorityMuscles String[]                    @default([])
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  archivedAt      DateTime?
  days            TrainingRoutineDay[]
  assignments     TrainingRoutineAssignment[]
  workoutSessions WorkoutSession[]
  versions        TrainingRoutineVersion[]

  @@index([objective])
  @@index([status])
  @@index([kind, status])
  @@map("training_routines")
}

model TrainingRoutineVersion {
  id          String          @id @default(cuid())
  routineId   String
  version     Int
  summary     String
  fingerprint String
  snapshot    Json
  createdAt   DateTime        @default(now())
  routine     TrainingRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, version])
  @@index([routineId, createdAt])
  @@map("training_routine_versions")
}

model TrainingRoutineDay {
  id               String                    @id @default(cuid())
  routineId        String
  dayNumber        Int
  name             String                    @default("")
  objective        String                    @default("")
  warmup           String                    @default("")
  observations     String                    @default("")
  estimatedMinutes Int?
  routine          TrainingRoutine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  blocks           TrainingRoutineBlock[]
  exercises        TrainingRoutineExercise[]
  workoutSessions  WorkoutSession[]
  active           Boolean                   @default(true)
  archivedAt       DateTime?

  @@index([routineId, active])
  @@index([routineId, dayNumber])
  @@map("training_routine_days")
}

model TrainingRoutineBlock {
  id                       String                    @id @default(cuid())
  routineDayId             String
  type                     TrainingBlockType
  name                     String                    @default("")
  order                    Int
  rounds                   Int?
  durationSeconds          Int?
  workSeconds              Int?
  restSeconds              Int?
  restBetweenRoundsSeconds Int?
  targetRounds             Int?
  instructions             String                    @default("")
  active                   Boolean                   @default(true)
  archivedAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  day                      TrainingRoutineDay        @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exercises                TrainingRoutineExercise[]
  workoutLogs              WorkoutBlockLog[]

  @@index([routineDayId, order])
  @@index([routineDayId, active])
  @@map("training_routine_blocks")
}

model TrainingRoutineExercise {
  id                  String               @id @default(cuid())
  dayId               String
  blockId             String
  name                String
  muscleGroup         String
  sets                Int
  repetitions         String
  weight              Decimal?             @db.Decimal(7, 2)
  effortType          TrainingEffortType
  effortValue         Decimal?             @db.Decimal(4, 1)
  restSeconds         Int?
  observations        String               @default("")
  videoUrl            String?
  tempo               String?
  alternativeExercise String?
  equipment           String?
  optional            Boolean              @default(false)
  targetType          TrainingExerciseTargetType @default(REPS)
  targetSeconds       Int?
  targetRepetitions   String?
  targetDistance      String?
  targetSide          String?
  order               Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  day                 TrainingRoutineDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  block               TrainingRoutineBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  workoutLogs         WorkoutExerciseLog[]
  followUpComments    FollowUpComment[]
  active              Boolean              @default(true)
  archivedAt          DateTime?

  @@index([dayId, order])
  @@index([dayId, active])
  @@index([blockId, order])
  @@map("training_routine_exercises")
}

model TrainingRoutineAssignment {
  routineId  String
  studentId  String
  assignedAt DateTime        @default(now())
  active     Boolean         @default(true)
  archivedAt DateTime?
  routine    TrainingRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  student    StudentRecord   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([routineId, studentId])
  @@index([studentId])
  @@index([studentId, active])
  @@map("training_routine_assignments")
}

model EvaluationRecord {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("evaluations")
}

model PhysicalEvaluation {
  id                String            @id @default(cuid())
  studentId         String
  date              DateTime
  weight            Decimal?          @db.Decimal(7, 2)
  height            Decimal?          @db.Decimal(5, 2)
  bodyFatPercentage Decimal?          @db.Decimal(5, 2)
  muscleMass        Decimal?          @db.Decimal(7, 2)
  visceralFat       Decimal?          @db.Decimal(5, 2)
  waist             Decimal?          @db.Decimal(7, 2)
  hip               Decimal?          @db.Decimal(7, 2)
  chest             Decimal?          @db.Decimal(7, 2)
  rightArm          Decimal?          @db.Decimal(7, 2)
  leftArm           Decimal?          @db.Decimal(7, 2)
  rightThigh        Decimal?          @db.Decimal(7, 2)
  leftThigh         Decimal?          @db.Decimal(7, 2)
  rightCalf         Decimal?          @db.Decimal(7, 2)
  leftCalf          Decimal?          @db.Decimal(7, 2)
  notes             String            @default("")
  frontPhotoUrl     String?
  sidePhotoUrl      String?
  backPhotoUrl      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  student           StudentRecord     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  followUpComments  FollowUpComment[]

  @@index([studentId, date])
  @@map("physical_evaluations")
}

enum WorkoutSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model WorkoutSession {
  id                                 String               @id @default(cuid())
  studentId                          String
  routineId                          String?
  dayId                              String?
  routineNameSnapshot                String
  routineDayNumberSnapshot           Int
  routineDayNameSnapshot             String               @default("")
  routineDayEstimatedMinutesSnapshot Int?
  date                               DateTime             @db.Date
  startTime                          String
  durationMinutes                    Int?
  energyBefore                       Int?
  difficulty                         Int?
  energyAfter                        Int?
  finalComment                       String               @default("")
  hasPain                            Boolean              @default(false)
  painDetails                        String               @default("")
  status                             WorkoutSessionStatus @default(PENDING)
  createdAt                          DateTime             @default(now())
  updatedAt                          DateTime             @updatedAt
  student                            StudentRecord        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  routine                            TrainingRoutine?     @relation(fields: [routineId], references: [id], onDelete: SetNull)
  day                                TrainingRoutineDay?  @relation(fields: [dayId], references: [id], onDelete: SetNull)
  exercises                          WorkoutExerciseLog[]
  blocks                             WorkoutBlockLog[]
  comments                           FollowUpComment[]

  @@index([studentId, date])
  @@index([status, updatedAt])
  @@map("workout_sessions")
}

model WorkoutBlockLog {
  id                  String                @id @default(cuid())
  sessionId           String
  blockId             String?
  blockReferenceId    String
  snapshotVersion     Int                   @default(1)
  blockName           String
  blockType           TrainingBlockType
  blockOrder          Int
  blockConfiguration  Json
  exercisesSnapshot   Json
  result              Json
  completed           Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  session             WorkoutSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  block               TrainingRoutineBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@unique([sessionId, blockReferenceId])
  @@index([blockReferenceId, updatedAt])
  @@map("workout_block_logs")
}

model WorkoutExerciseLog {
  id                  String                   @id @default(cuid())
  sessionId           String
  exerciseId          String?
  exerciseReferenceId String
  observation         String                   @default("")
  snapshotVersion     Int?
  exerciseName        String?
  targetSets          Int?
  targetRepetitions   String?
  suggestedWeight     Decimal?                 @db.Decimal(7, 2)
  targetEffortType    TrainingEffortType?
  targetEffortValue   Decimal?                 @db.Decimal(4, 1)
  targetRestSeconds   Int?
  coachInstructions   String?
  exerciseOrder       Int?
  routineName         String?
  routineDayNumber    Int?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  session             WorkoutSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise            TrainingRoutineExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets                WorkoutSetLog[]

  @@unique([sessionId, exerciseId])
  @@index([exerciseId, updatedAt])
  @@index([exerciseReferenceId, updatedAt])
  @@map("workout_exercise_logs")
}

model WorkoutSetLog {
  id            String             @id @default(cuid())
  exerciseLogId String
  setNumber     Int
  weight        Decimal?           @db.Decimal(7, 2)
  repetitions   Int?
  effort        Decimal?           @db.Decimal(4, 1)
  completed     Boolean            @default(false)
  observation   String             @default("")
  exerciseLog   WorkoutExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@unique([exerciseLogId, setNumber])
  @@map("workout_set_logs")
}

enum FollowUpAuthor {
  STUDENT
  COACH
}

enum FollowUpContext {
  SESSION
  EXERCISE
  EVALUATION
  GENERAL
}

enum FollowUpCategory {
  QUESTION
  DIFFICULTY
  PAIN
  FEEDBACK
}

enum FollowUpStatus {
  PENDING
  REVIEWED
}

model FollowUpComment {
  id           String                   @id @default(cuid())
  studentId    String
  author       FollowUpAuthor
  context      FollowUpContext
  category     FollowUpCategory
  status       FollowUpStatus           @default(PENDING)
  body         String
  private      Boolean                  @default(false)
  sessionId    String?
  exerciseId   String?
  evaluationId String?
  parentId     String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  student      StudentRecord            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session      WorkoutSession?          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise     TrainingRoutineExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  evaluation   PhysicalEvaluation?      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  parent       FollowUpComment?         @relation("FollowUpReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      FollowUpComment[]        @relation("FollowUpReplies")

  @@index([studentId, createdAt])
  @@index([status, category])
  @@index([parentId])
  @@map("follow_up_comments")
}

model CoachSettingsRecord {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coach_settings")
}

enum ClassWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model WeeklyClassSchedule {
  id              String                  @id @default(cuid())
  dayOfWeek       ClassWeekday
  startTime       String
  endTime         String
  classType       String
  capacity        Int?
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  assignments     WeeklyClassAssignment[]
  attendances     ClassAttendance[]
  primaryStudents StudentRecord[]         @relation("StudentPrimarySchedule")
  occurrences     ClassOccurrence[]

  @@index([dayOfWeek, startTime])
  @@index([active])
  @@map("weekly_class_schedules")
}

enum ClassOccurrenceStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ClassResponseStatus {
  GOING
  NOT_GOING
}

enum ClassActualAttendance {
  UNKNOWN
  PRESENT
  ABSENT
  CANCELLED
}

enum ClassWorkoutLogStatus {
  DRAFT
  COMPLETED
}

enum ClassWorkoutLogAuthor {
  UNKNOWN
  STUDENT
  TRAINER
}

model ClassOccurrence {
  id                   String                      @id @default(cuid())
  scheduleId           String?
  date                 DateTime                    @db.Date
  startTime            String
  endTime              String
  classNameSnapshot    String
  categorySnapshot     String
  status               ClassOccurrenceStatus       @default(SCHEDULED)
  capacityOverride     Int?
  internalNotes        String                      @default("")
  strengthEnabled      Boolean                     @default(false)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  schedule             WeeklyClassSchedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  responses            ClassOccurrenceAttendance[]
  strengthBlock        ClassStrengthBlock?
  workoutLogs          ClassWorkoutLog[]
  trainerNotifications TrainerNotification[]

  @@unique([scheduleId, date])
  @@index([date, startTime])
  @@index([status, date])
  @@map("class_occurrences")
}

model ClassOccurrenceAttendance {
  id               String                @id @default(cuid())
  occurrenceId     String
  studentId        String
  response         ClassResponseStatus?
  actualAttendance ClassActualAttendance @default(UNKNOWN)
  respondedAt      DateTime?
  checkedInAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  occurrence       ClassOccurrence       @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  student          StudentRecord         @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([occurrenceId, studentId])
  @@index([studentId, updatedAt])
  @@index([occurrenceId, response])
  @@map("class_occurrence_attendances")
}

model ClassStrengthBlock {
  id           String                  @id @default(cuid())
  occurrenceId String                  @unique
  name         String
  notes        String                  @default("")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  occurrence   ClassOccurrence         @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  exercises    ClassStrengthExercise[]

  @@map("class_strength_blocks")
}

model ClassStrengthExercise {
  id              String             @id @default(cuid())
  strengthBlockId String
  exerciseName    String
  order           Int
  suggestedSets   Int
  suggestedReps   String
  instructions    String             @default("")
  strengthBlock   ClassStrengthBlock @relation(fields: [strengthBlockId], references: [id], onDelete: Cascade)

  @@unique([strengthBlockId, order])
  @@map("class_strength_exercises")
}

model ClassWorkoutLog {
  id                String                @id @default(cuid())
  occurrenceId      String
  studentId         String
  classNameSnapshot String
  classDateSnapshot DateTime              @db.Date
  status            ClassWorkoutLogStatus @default(DRAFT)
  notes             String                @default("")
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         ClassWorkoutLogAuthor @default(UNKNOWN)
  lastEditedBy      ClassWorkoutLogAuthor @default(UNKNOWN)
  occurrence        ClassOccurrence       @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  student           StudentRecord         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  exercises         ClassExerciseLog[]

  @@unique([occurrenceId, studentId])
  @@index([studentId, classDateSnapshot])
  @@map("class_workout_logs")
}

model ClassExerciseLog {
  id                   String                    @id @default(cuid())
  classWorkoutLogId    String
  exerciseNameSnapshot String
  order                Int
  notes                String                    @default("")
  workoutLog           ClassWorkoutLog           @relation(fields: [classWorkoutLogId], references: [id], onDelete: Cascade)
  sets                 ClassSetLog[]
  feedback             ClassExerciseLogFeedback?

  @@unique([classWorkoutLogId, order])
  @@map("class_exercise_logs")
}

model ClassExerciseLogFeedback {
  id                 String           @id @default(cuid())
  classExerciseLogId String           @unique
  studentId          String
  trainerName        String
  preset             String           @default("")
  text               String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  classExerciseLog   ClassExerciseLog @relation(fields: [classExerciseLogId], references: [id], onDelete: Cascade)
  student            StudentRecord    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt(sort: Desc)])
  @@map("class_exercise_log_feedback")
}

model ClassSetLog {
  id                 String           @id @default(cuid())
  classExerciseLogId String
  setNumber          Int
  weight             Decimal?         @db.Decimal(7, 2)
  repetitions        Int?
  effort             Decimal?         @db.Decimal(4, 1)
  unit               String           @default("kg")
  notes              String           @default("")
  exerciseLog        ClassExerciseLog @relation(fields: [classExerciseLogId], references: [id], onDelete: Cascade)

  @@unique([classExerciseLogId, setNumber])
  @@map("class_set_logs")
}

model WeeklyClassAssignment {
  scheduleId String
  studentId  String
  assignedAt DateTime            @default(now())
  active     Boolean             @default(true)
  endedAt    DateTime?
  schedule   WeeklyClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student    StudentRecord       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([scheduleId, studentId])
  @@index([studentId, active])
  @@map("weekly_class_assignments")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

model ClassAttendance {
  id                String               @id @default(cuid())
  scheduleId        String?
  studentId         String
  date              DateTime             @db.Date
  status            AttendanceStatus
  scheduleLabel     String
  scheduleStartTime String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  schedule          WeeklyClassSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  student           StudentRecord        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId, date])
  @@index([date])
  @@index([studentId, date])
  @@index([status, date])
  @@map("class_attendances")
}

model ClassSession {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  startTime   String
  endTime     String
  location    String
  capacity    Int
  status      String   @default("programada")
  description String   @default("")
  students    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("classes")
}
