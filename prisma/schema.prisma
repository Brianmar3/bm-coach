generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudentRecord {
  id                       String                      @id
  phoneNormalized          String?                     @unique
  primaryScheduleId        String?
  serviceType              StudentServiceType          @default(CLASSES)
  data                     Json
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  payments                 StudentPayment[]
  physicalEvaluations      PhysicalEvaluation[]
  routineAssignments       TrainingRoutineAssignment[]
  weeklyClasses            WeeklyClassAssignment[]
  attendances              ClassAttendance[]
  primarySchedule          WeeklyClassSchedule?        @relation("StudentPrimarySchedule", fields: [primaryScheduleId], references: [id], onDelete: SetNull)
  portalCredential         StudentPortalCredential?
  workoutSessions          WorkoutSession[]
  followUpComments         FollowUpComment[]
  classResponses           ClassOccurrenceAttendance[]
  classWorkoutLogs         ClassWorkoutLog[]
  pushSubscriptions        StudentPushSubscription[]
  achievementNotifications AchievementNotification[]
  quickLogs                QuickLog[]
  quickLogAchievements     QuickLogAchievement[]
  quickLogFeedbacks        QuickLogFeedback[]
  trainerNotifications     TrainerNotification[]
  notifications            StudentNotification[]

  @@index([primaryScheduleId])
  @@map("students")
}

enum StudentServiceType {
  CLASSES
  PERSONALIZED
  MIXED
}

enum QuickLogType {
  WORKOUT
  NOTE
  PROGRESS
  PHOTO
}

model QuickLog {
  id                  String                @id @default(cuid())
  studentId           String
  type                QuickLogType
  title               String                @default("")
  content             String                @default("")
  category            String                @default("")
  date                DateTime              @db.Date
  durationMinutes     Int?
  exerciseName        String                @default("")
  exerciseKey         String                @default("")
  idempotencyKey      String?               @unique
  sets                Int?
  repetitions         Int?
  previousSets        Int?
  previousRepetitions Int?
  metricType          String                @default("")
  previousValue       Decimal?              @db.Decimal(10, 2)
  currentValue        Decimal?              @db.Decimal(10, 2)
  unit                String                @default("")
  mood                String                @default("")
  hasPain             Boolean               @default(false)
  painDetails         String                @default("")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  student             StudentRecord         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  photos              QuickLogPhoto[]
  achievements        QuickLogAchievement[]
  feedback            QuickLogFeedback?

  @@index([studentId, date(sort: Desc)])
  @@index([studentId, type, date(sort: Desc)])
  @@index([studentId, exerciseKey, createdAt(sort: Desc)])
  @@map("quick_logs")
}

model QuickLogPhoto {
  id           String   @id @default(cuid())
  quickLogId   String
  blobUrl      String
  blobPathname String
  createdAt    DateTime @default(now())
  quickLog     QuickLog @relation(fields: [quickLogId], references: [id], onDelete: Cascade)

  @@index([quickLogId])
  @@map("quick_log_photos")
}

enum QuickLogAchievementType {
  FIRST_MARK
  MAX_LOAD
  REPETITION_PR
  RECORD_MILESTONE
}

model QuickLogAchievement {
  id             String                  @id @default(cuid())
  studentId      String
  quickLogId     String
  achievementKey String
  type           QuickLogAchievementType
  exerciseName   String
  exerciseKey    String
  sets           Int?
  repetitions    Int?
  unit           String                  @default("")
  currentLoad    Decimal?                @db.Decimal(10, 2)
  previousLoad   Decimal?                @db.Decimal(10, 2)
  difference     Decimal?                @db.Decimal(10, 2)
  recordCount    Int?
  unlockedAt     DateTime
  createdAt      DateTime                @default(now())
  student        StudentRecord           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  quickLog       QuickLog                @relation(fields: [quickLogId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementKey])
  @@index([studentId, unlockedAt(sort: Desc)])
  @@index([quickLogId])
  @@map("quick_log_achievements")
}

model QuickLogFeedback {
  id          String        @id @default(cuid())
  quickLogId  String        @unique
  studentId   String
  trainerName String
  preset      String        @default("")
  text        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  quickLog    QuickLog      @relation(fields: [quickLogId], references: [id], onDelete: Cascade)
  student     StudentRecord @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt(sort: Desc)])
  @@map("quick_log_feedback")
}

enum AchievementNotificationStatus {
  BASELINE
  PENDING
  SENT
  FAILED
}

model StudentPushSubscription {
  id          String        @id @default(cuid())
  studentId   String
  endpoint    String        @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceLabel String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lastUsedAt  DateTime?
  student     StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, active])
  @@map("student_push_subscriptions")
}

model AchievementNotification {
  id             String                        @id @default(cuid())
  studentId      String
  achievementKey String
  unlockedAt     DateTime
  notifiedAt     DateTime?
  status         AchievementNotificationStatus @default(PENDING)
  error          String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  student        StudentRecord                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementKey])
  @@index([studentId, status])
  @@index([status, createdAt])
  @@map("achievement_notifications")
}

enum StudentNotificationType {
  MESSAGE
  FEEDBACK
  ANNOUNCEMENT
  EVENT
  NEWS
  REMINDER
  ACHIEVEMENT
}

model StudentNotification {
  id        String                  @id @default(cuid())
  studentId String
  type      StudentNotificationType
  title     String
  message   String
  url       String                  @default("/portal")
  readAt    DateTime?
  createdAt DateTime                @default(now())
  student   StudentRecord           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, readAt, createdAt(sort: Desc)])
  @@map("student_notifications")
}

enum TrainerNotificationType {
  CLASS_RESPONSE
}

model TrainerPushSubscription {
  id          String    @id @default(cuid())
  ownerKey    String    @default("coach")
  endpoint    String    @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceLabel String?
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerKey, active])
  @@map("trainer_push_subscriptions")
}

model TrainerNotification {
  id              String                  @id @default(cuid())
  ownerKey        String                  @default("coach")
  type            TrainerNotificationType
  eventKey        String                  @unique
  title           String
  message         String
  url             String
  studentId       String?
  occurrenceId    String?
  response        ClassResponseStatus
  readAt          DateTime?
  pushAttemptedAt DateTime?
  pushDeliveredAt DateTime?
  pushError       String?
  createdAt       DateTime                @default(now())
  student         StudentRecord?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  occurrence      ClassOccurrence?        @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  @@index([ownerKey, readAt, createdAt(sort: Desc)])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([occurrenceId, createdAt(sort: Desc)])
  @@map("trainer_notifications")
}

model StudentPortalCredential {
  studentId           String                 @id
  username            String                 @unique
  passwordHash        String
  active              Boolean                @default(true)
  mustChangePassword  Boolean                @default(true)
  failedLoginAttempts Int                    @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  student             StudentRecord          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessions            StudentPortalSession[]

  @@map("student_portal_credentials")
}

model StudentPortalSession {
  id         String                  @id @default(cuid())
  studentId  String
  tokenHash  String                  @unique
  expiresAt  DateTime
  createdAt  DateTime                @default(now())
  lastUsedAt DateTime                @default(now())
  credential StudentPortalCredential @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@index([studentId])
  @@index([expiresAt])
  @@map("student_portal_sessions")
}

enum StudentPaymentStatus {
  PAGADO
  PENDIENTE
  VENCIDO
  PROXIMO_A_VENCER
  ANULADO
}

model StudentPayment {
  id                  String               @id @default(cuid())
  studentId           String
  amount              Decimal              @db.Decimal(12, 2)
  concept             String
  billingPeriod       DateTime?            @db.Date
  dueDate             DateTime
  nextDueDateSnapshot DateTime?            @db.Date
  paidDate            DateTime?
  method              String
  status              StudentPaymentStatus @default(PENDIENTE)
  notes               String               @default("")
  requestKey          String?              @unique
  voidedAt            DateTime?
  voidReason          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  student             StudentRecord        @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([studentId, paidDate])
  @@index([studentId, billingPeriod])
  @@index([status, dueDate])
  @@map("student_payments")
}

model PaymentRecord {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model EventRecord {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

enum CoachEventType {
  EVALUACION
  REUNION
  COMPETENCIA
  RECORDATORIO
}

enum CoachEventStatus {
  PENDIENTE
  COMPLETADO
}

model CoachEvent {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  date        DateTime
  time        String
  color       String           @default("#facc15")
  type        CoachEventType
  status      CoachEventStatus @default(PENDIENTE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([date, time])
  @@index([status])
  @@map("coach_events")
}

model RoutineRecord {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("routines")
}

enum TrainingRoutineLevel {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

enum TrainingRoutineStatus {
  BORRADOR
  ACTIVA
  FINALIZADA
  ARCHIVADA
}

enum TrainingRoutineKind {
  ASSIGNED
  TEMPLATE
}

enum TrainingEffortType {
  RPE
  RIR
}

model TrainingRoutine {
  id              String                      @id @default(cuid())
  name            String
  objective       String
  level           TrainingRoutineLevel
  status          TrainingRoutineStatus       @default(ACTIVA)
  kind            TrainingRoutineKind         @default(ASSIGNED)
  description     String                      @default("")
  location        String                      @default("")
  equipment       String[]                    @default([])
  tags            String[]                    @default([])
  startDate       DateTime?                   @db.Date
  durationWeeks   Int?
  priorityMuscles String[]                    @default([])
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  archivedAt      DateTime?
  days            TrainingRoutineDay[]
  assignments     TrainingRoutineAssignment[]
  workoutSessions WorkoutSession[]
  versions        TrainingRoutineVersion[]

  @@index([objective])
  @@index([status])
  @@index([kind, status])
  @@map("training_routines")
}

model TrainingRoutineVersion {
  id          String          @id @default(cuid())
  routineId   String
  version     Int
  summary     String
  fingerprint String
  snapshot    Json
  createdAt   DateTime        @default(now())
  routine     TrainingRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, version])
  @@index([routineId, createdAt])
  @@map("training_routine_versions")
}

model TrainingRoutineDay {
  id               String                    @id @default(cuid())
  routineId        String
  dayNumber        Int
  name             String                    @default("")
  objective        String                    @default("")
  observations     String                    @default("")
  estimatedMinutes Int?
  routine          TrainingRoutine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises        TrainingRoutineExercise[]
  workoutSessions  WorkoutSession[]
  active           Boolean                   @default(true)
  archivedAt       DateTime?

  @@index([routineId, active])
  @@index([routineId, dayNumber])
  @@map("training_routine_days")
}

model TrainingRoutineExercise {
  id                  String               @id @default(cuid())
  dayId               String
  name                String
  muscleGroup         String
  sets                Int
  repetitions         String
  weight              Decimal?             @db.Decimal(7, 2)
  effortType          TrainingEffortType
  effortValue         Decimal?             @db.Decimal(4, 1)
  restSeconds         Int?
  observations        String               @default("")
  videoUrl            String?
  tempo               String?
  alternativeExercise String?
  equipment           String?
  optional            Boolean              @default(false)
  order               Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  day                 TrainingRoutineDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  workoutLogs         WorkoutExerciseLog[]
  followUpComments    FollowUpComment[]
  active              Boolean              @default(true)
  archivedAt          DateTime?

  @@index([dayId, order])
  @@index([dayId, active])
  @@map("training_routine_exercises")
}

model TrainingRoutineAssignment {
  routineId  String
  studentId  String
  assignedAt DateTime        @default(now())
  active     Boolean         @default(true)
  archivedAt DateTime?
  routine    TrainingRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  student    StudentRecord   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([routineId, studentId])
  @@index([studentId])
  @@index([studentId, active])
  @@map("training_routine_assignments")
}

model EvaluationRecord {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("evaluations")
}

model PhysicalEvaluation {
  id                String            @id @default(cuid())
  studentId         String
  date              DateTime
  weight            Decimal?          @db.Decimal(7, 2)
  height            Decimal?          @db.Decimal(5, 2)
  bodyFatPercentage Decimal?          @db.Decimal(5, 2)
  muscleMass        Decimal?          @db.Decimal(7, 2)
  visceralFat       Decimal?          @db.Decimal(5, 2)
  waist             Decimal?          @db.Decimal(7, 2)
  hip               Decimal?          @db.Decimal(7, 2)
  chest             Decimal?          @db.Decimal(7, 2)
  rightArm          Decimal?          @db.Decimal(7, 2)
  leftArm           Decimal?          @db.Decimal(7, 2)
  rightThigh        Decimal?          @db.Decimal(7, 2)
  leftThigh         Decimal?          @db.Decimal(7, 2)
  rightCalf         Decimal?          @db.Decimal(7, 2)
  leftCalf          Decimal?          @db.Decimal(7, 2)
  notes             String            @default("")
  frontPhotoUrl     String?
  sidePhotoUrl      String?
  backPhotoUrl      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  student           StudentRecord     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  followUpComments  FollowUpComment[]

  @@index([studentId, date])
  @@map("physical_evaluations")
}

enum WorkoutSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model WorkoutSession {
  id                                 String               @id @default(cuid())
  studentId                          String
  routineId                          String?
  dayId                              String?
  routineNameSnapshot                String
  routineDayNumberSnapshot           Int
  routineDayNameSnapshot             String               @default("")
  routineDayEstimatedMinutesSnapshot Int?
  date                               DateTime             @db.Date
  startTime                          String
  durationMinutes                    Int?
  energyBefore                       Int?
  difficulty                         Int?
  energyAfter                        Int?
  finalComment                       String               @default("")
  hasPain                            Boolean              @default(false)
  painDetails                        String               @default("")
  status                             WorkoutSessionStatus @default(PENDING)
  createdAt                          DateTime             @default(now())
  updatedAt                          DateTime             @updatedAt
  student                            StudentRecord        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  routine                            TrainingRoutine?     @relation(fields: [routineId], references: [id], onDelete: SetNull)
  day                                TrainingRoutineDay?  @relation(fields: [dayId], references: [id], onDelete: SetNull)
  exercises                          WorkoutExerciseLog[]
  comments                           FollowUpComment[]

  @@index([studentId, date])
  @@index([status, updatedAt])
  @@map("workout_sessions")
}

model WorkoutExerciseLog {
  id                  String                   @id @default(cuid())
  sessionId           String
  exerciseId          String?
  exerciseReferenceId String
  observation         String                   @default("")
  snapshotVersion     Int?
  exerciseName        String?
  targetSets          Int?
  targetRepetitions   String?
  suggestedWeight     Decimal?                 @db.Decimal(7, 2)
  targetEffortType    TrainingEffortType?
  targetEffortValue   Decimal?                 @db.Decimal(4, 1)
  targetRestSeconds   Int?
  coachInstructions   String?
  exerciseOrder       Int?
  routineName         String?
  routineDayNumber    Int?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  session             WorkoutSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise            TrainingRoutineExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets                WorkoutSetLog[]

  @@unique([sessionId, exerciseId])
  @@index([exerciseId, updatedAt])
  @@index([exerciseReferenceId, updatedAt])
  @@map("workout_exercise_logs")
}

model WorkoutSetLog {
  id            String             @id @default(cuid())
  exerciseLogId String
  setNumber     Int
  weight        Decimal?           @db.Decimal(7, 2)
  repetitions   Int?
  effort        Decimal?           @db.Decimal(4, 1)
  completed     Boolean            @default(false)
  observation   String             @default("")
  exerciseLog   WorkoutExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@unique([exerciseLogId, setNumber])
  @@map("workout_set_logs")
}

enum FollowUpAuthor {
  STUDENT
  COACH
}

enum FollowUpContext {
  SESSION
  EXERCISE
  EVALUATION
  GENERAL
}

enum FollowUpCategory {
  QUESTION
  DIFFICULTY
  PAIN
  FEEDBACK
}

enum FollowUpStatus {
  PENDING
  REVIEWED
}

model FollowUpComment {
  id           String                   @id @default(cuid())
  studentId    String
  author       FollowUpAuthor
  context      FollowUpContext
  category     FollowUpCategory
  status       FollowUpStatus           @default(PENDING)
  body         String
  private      Boolean                  @default(false)
  sessionId    String?
  exerciseId   String?
  evaluationId String?
  parentId     String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  student      StudentRecord            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session      WorkoutSession?          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise     TrainingRoutineExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  evaluation   PhysicalEvaluation?      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  parent       FollowUpComment?         @relation("FollowUpReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      FollowUpComment[]        @relation("FollowUpReplies")

  @@index([studentId, createdAt])
  @@index([status, category])
  @@index([parentId])
  @@map("follow_up_comments")
}

model CoachSettingsRecord {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coach_settings")
}

enum ClassWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model WeeklyClassSchedule {
  id              String                  @id @default(cuid())
  dayOfWeek       ClassWeekday
  startTime       String
  endTime         String
  classType       String
  capacity        Int?
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  assignments     WeeklyClassAssignment[]
  attendances     ClassAttendance[]
  primaryStudents StudentRecord[]         @relation("StudentPrimarySchedule")
  occurrences     ClassOccurrence[]

  @@index([dayOfWeek, startTime])
  @@index([active])
  @@map("weekly_class_schedules")
}

enum ClassOccurrenceStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ClassResponseStatus {
  GOING
  NOT_GOING
}

enum ClassActualAttendance {
  UNKNOWN
  PRESENT
  ABSENT
  CANCELLED
}

enum ClassWorkoutLogStatus {
  DRAFT
  COMPLETED
}

model ClassOccurrence {
  id                   String                      @id @default(cuid())
  scheduleId           String?
  date                 DateTime                    @db.Date
  startTime            String
  endTime              String
  classNameSnapshot    String
  categorySnapshot     String
  status               ClassOccurrenceStatus       @default(SCHEDULED)
  capacityOverride     Int?
  internalNotes        String                      @default("")
  strengthEnabled      Boolean                     @default(false)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  schedule             WeeklyClassSchedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  responses            ClassOccurrenceAttendance[]
  strengthBlock        ClassStrengthBlock?
  workoutLogs          ClassWorkoutLog[]
  trainerNotifications TrainerNotification[]

  @@unique([scheduleId, date])
  @@index([date, startTime])
  @@index([status, date])
  @@map("class_occurrences")
}

model ClassOccurrenceAttendance {
  id               String                @id @default(cuid())
  occurrenceId     String
  studentId        String
  response         ClassResponseStatus?
  actualAttendance ClassActualAttendance @default(UNKNOWN)
  respondedAt      DateTime?
  checkedInAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  occurrence       ClassOccurrence       @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  student          StudentRecord         @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([occurrenceId, studentId])
  @@index([studentId, updatedAt])
  @@index([occurrenceId, response])
  @@map("class_occurrence_attendances")
}

model ClassStrengthBlock {
  id           String                  @id @default(cuid())
  occurrenceId String                  @unique
  name         String
  notes        String                  @default("")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  occurrence   ClassOccurrence         @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  exercises    ClassStrengthExercise[]

  @@map("class_strength_blocks")
}

model ClassStrengthExercise {
  id              String             @id @default(cuid())
  strengthBlockId String
  exerciseName    String
  order           Int
  suggestedSets   Int
  suggestedReps   String
  instructions    String             @default("")
  strengthBlock   ClassStrengthBlock @relation(fields: [strengthBlockId], references: [id], onDelete: Cascade)

  @@unique([strengthBlockId, order])
  @@map("class_strength_exercises")
}

model ClassWorkoutLog {
  id                String                @id @default(cuid())
  occurrenceId      String
  studentId         String
  classNameSnapshot String
  classDateSnapshot DateTime              @db.Date
  status            ClassWorkoutLogStatus @default(DRAFT)
  notes             String                @default("")
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  occurrence        ClassOccurrence       @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  student           StudentRecord         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  exercises         ClassExerciseLog[]

  @@unique([occurrenceId, studentId])
  @@index([studentId, classDateSnapshot])
  @@map("class_workout_logs")
}

model ClassExerciseLog {
  id                   String          @id @default(cuid())
  classWorkoutLogId    String
  exerciseNameSnapshot String
  order                Int
  notes                String          @default("")
  workoutLog           ClassWorkoutLog @relation(fields: [classWorkoutLogId], references: [id], onDelete: Cascade)
  sets                 ClassSetLog[]

  @@unique([classWorkoutLogId, order])
  @@map("class_exercise_logs")
}

model ClassSetLog {
  id                 String           @id @default(cuid())
  classExerciseLogId String
  setNumber          Int
  weight             Decimal?         @db.Decimal(7, 2)
  repetitions        Int?
  effort             Decimal?         @db.Decimal(4, 1)
  unit               String           @default("kg")
  notes              String           @default("")
  exerciseLog        ClassExerciseLog @relation(fields: [classExerciseLogId], references: [id], onDelete: Cascade)

  @@unique([classExerciseLogId, setNumber])
  @@map("class_set_logs")
}

model WeeklyClassAssignment {
  scheduleId String
  studentId  String
  assignedAt DateTime            @default(now())
  active     Boolean             @default(true)
  endedAt    DateTime?
  schedule   WeeklyClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student    StudentRecord       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([scheduleId, studentId])
  @@index([studentId, active])
  @@map("weekly_class_assignments")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

model ClassAttendance {
  id                String               @id @default(cuid())
  scheduleId        String?
  studentId         String
  date              DateTime             @db.Date
  status            AttendanceStatus
  scheduleLabel     String
  scheduleStartTime String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  schedule          WeeklyClassSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  student           StudentRecord        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId, date])
  @@index([date])
  @@index([studentId, date])
  @@index([status, date])
  @@map("class_attendances")
}

model ClassSession {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  startTime   String
  endTime     String
  location    String
  capacity    Int
  status      String   @default("programada")
  description String   @default("")
  students    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("classes")
}
