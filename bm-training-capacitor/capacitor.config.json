{
  "appId": "com.bmtraining.app",
  "appName": "BM Training",
  "webDir": "www",
  "loggingBehavior": "debug",
  "backgroundColor": "#000000",
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "useLegacyBridge": false
  },
  "server": {
    "url": "https://bm-training-app.vercel.app",
    "appStartPath": "/portal/login",
    "cleartext": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_bm_notification",
      "iconColor": "#FACC15"
    }
  }
}
